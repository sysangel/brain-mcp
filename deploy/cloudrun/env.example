# Cloud Run runtime. Copy into the service env. Do not commit real values.
#
# Supabase is the database. This service is only the MCP process.
# Use the Supavisor *transaction* pooler URI (port 6543), not the direct
# 5432 URI and not the service-role key. The app sets prepare_threshold=None.
#
# Copy the pooler host from the Supabase Connect panel. The aws-0 / aws-1
# prefix differs between projects; the wrong one returns tenant not found.
# Runtime: transaction pooler, port 6543. Secret name: brain-database-url
# Ops (migrate, load, re-embed): session pooler, port 5432.
#   Secret name: brain-database-url-ops
# brain_app password secret: brain-app-db-password
# postgresql://postgres.<project-ref>:<password>@aws-0-SUPABASE_REGION.pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-SUPABASE_REGION.pooler.supabase.com:6543/postgres
BRAIN_BACKEND=postgres
BRAIN_PG_POOL_MAX=4

# OpenAI embeddings from this container. Not Supabase Edge Functions.
BRAIN_EMBED_PROVIDER=openai
BRAIN_EMBED_MODEL=text-embedding-3-small
BRAIN_EMBED_DIM=256
# Secret Manager name: openai-api-key
OPENAI_API_KEY=sk-replace-me
# Optional prior. Default for this space is 0.40.
# BRAIN_VEC_FLOOR_COS=0.40

# Public origin of this Cloud Run service, no trailing path.
BRAIN_PUBLIC_URL=https://brain-xxxxx.a.run.app
BRAIN_HTTP_HOST=0.0.0.0
# Cloud Run sets PORT. Local default is 8080.

# Google OAuth client (APIs & Services → Credentials → Web application).
# Authorized redirect URI: ${BRAIN_PUBLIC_URL}/auth/callback
BRAIN_GOOGLE_CLIENT_ID=000000000000-xxxx.apps.googleusercontent.com
# Secret Manager name: brain-google-client-secret
BRAIN_GOOGLE_CLIENT_SECRET=replace-me
# Workspace hosted domain, without @. The server refuses to start if both
# this and BRAIN_AUTH_ALLOWED_EMAILS are empty.
BRAIN_AUTH_DOMAIN=example.com
# BRAIN_AUTH_ALLOWED_EMAILS=you@example.com
# BRAIN_AUTH_EMAIL_PROFILES=you@example.com=personal|work
# BRAIN_AUTH_DEFAULT_PROFILE=personal
# BRAIN_AUTH_DEFAULT_WRITE=1
# Secret Manager name: brain-jwt-signing-key
# OAuth client registrations and token mappings are stored encrypted in
# brain.oauth_kv (same DATABASE_URL). Keep this value stable across deploys;
# rotating it invalidates stored tokens. If unset, the key is derived from
# BRAIN_GOOGLE_CLIENT_SECRET.
# BRAIN_JWT_SIGNING_KEY=

# Migrations, brain-pg-load, and brain-pg-reembed use the session pooler
# (port 5432) on the same host, secret brain-database-url-ops. Do not point
# those commands at the transaction pooler (port 6543) above.
# Probe path is /health, not /healthz.

# Privacy gates for pushed sessions and digests. Substring matches on cwd.
# Episodes matching BRAIN_EPISODE_EXCLUDE are stored and recallable but never
# queued for the git export (it defaults to BRAIN_DIGEST_EXCLUDE). Sessions
# matching BRAIN_DIGEST_EXCLUDE are never digested by reflect.
# BRAIN_DIGEST_EXCLUDE=personal-finance
# BRAIN_EPISODE_EXCLUDE=personal-finance
# Nightly job only: backup bucket and the zone that names the dump's date.
# BRAIN_BACKUP_BUCKET=PROJECT_ID-brain-backups
# BRAIN_BACKUP_TZ=UTC
# Nightly job only: the GitHub repo (owner/name) the export commits to.
# BRAIN_GIT_REPO=OWNER/brain
# BRAIN_GIT_BRANCH=main
# Device routes (/ingest/episodes, /hook/*) take device tokens, not OAuth.
# They need migration 0006_device_tokens.sql.
