[Unit]
Description=brain: pull + ingest episode files, then audit state-note freshness

[Service]
Type=oneshot
WorkingDirectory=%h/src/brain-mcp
# CLAUDE_CODE_OAUTH_TOKEN for the headless `claude -p` refresh agents
EnvironmentFile=%h/.config/claude.env
# The VM ingests from episodes/ (git transport) — never from its own local
# claude transcripts, which exist here because the refresh agents run claude.
Environment=BRAIN_INGEST_SOURCE=episodes
# 2GB droplet: a single embedder thread + small backfill chunk keep peak RAM
# under the swap ceiling (the seed ingest was OOM-killed at THREADS=2).
Environment=BRAIN_EMBED_THREADS=1
Environment=BRAIN_EMBED_BACKFILL_CHUNK=32
Environment=BRAIN_EMBED_BATCH=4
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Ingest first so episodes_since reads a freshly-topped index, then audit.
ExecStart=%h/.local/bin/uv run --directory %h/src/brain-mcp brain-ingest
ExecStart=%h/.local/bin/uv run --directory %h/src/brain-mcp brain-freshness-audit
# Worst case: ~900s ingest lock wait + BRAIN_AUDIT_MAX_REFRESH (3) refresh agents
# each self-bounding at BRAIN_AUDIT_REFRESH_TIMEOUT (1800s) = 6300s; round up.
TimeoutStartSec=9600
